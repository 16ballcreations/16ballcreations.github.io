{
  "name": "16bc-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && wrangler dev --port 8787",
    "deploy": "node scripts/build.mjs && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply 16bc --remote",
    "db:migrate:local": "wrangler d1 migrations apply 16bc --local"
  },
  "devDependencies": {
    "wrangler": "4.145.0"
  }
}
